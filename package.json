{
  "name": "@chr33s/storybook-addon-fetch-mock",
  "version": "3.2.0",
  "description": "Adds fetch() mocking to Storybook.js using fetch-mock",
  "author": "John Albin Wilkins <virtually.johnalbin@gmail.com> (https://john.albin.net/)",
  "homepage": "https://github.com/chr33s/storybook-addon-fetch-mock#readme",
  "bugs": {
    "url": "https://github.com/chr33s/storybook-addon-fetch-mock/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chr33s/storybook-addon-fetch-mock.git"
  },
  "license": "(MIT OR GPL-2.0-only)",
  "keywords": [
    "storybook-addons",
    "data-state",
    "fetch",
    "fetch-mock"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "default": "./dist/preview.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "npm run build --watch",
    "prepare": "npm run build",
    "lint": "eslint --ignore-pattern=dist .",
    "lint:fix": "eslint --fix --ignore-pattern=dist .",
    "prettier": "prettier --write \"{.*/**/*,*,**/*}.{js,jsx,ts,tsx,json,md,yml,css,scss}\"",
    "prettier:check": "prettier --check \"{.*/**/*,*,**/*}.{js,jsx,ts,tsx,json,md,yml,css,scss}\"",
    "format": "npm run lint:fix && npm run prettier",
    "ci:lint": "npm run lint && npm run prettier:check",
    "pretest": "npm run ci:lint",
    "test": "echo \"Error: no test specified\" && exit 1",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build"
  },
  "dependencies": {
    "fetch-mock": "12.6.0"
  },
  "peerDependencies": {
    "storybook": ">=9.0.0"
  },
  "devDependencies": {
    "@eslint/compat": "2.0.0",
    "@eslint/eslintrc": "3.3.3",
    "@eslint/js": "9.39.2",
    "@storybook/react": "10.1.11",
    "@storybook/react-vite": "10.1.11",
    "@types/react": "19.2.7",
    "@typescript-eslint/eslint-plugin": "8.52.0",
    "@typescript-eslint/parser": "8.52.0",
    "@vitejs/plugin-react": "5.1.2",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-unused-imports": "4.3.0",
    "globals": "17.0.0",
    "prettier": "3.7.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "release-please": "17.1.3",
    "storybook": "10.1.11",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  },
  "storybook": {
    "displayName": "Mock fetch()",
    "supportedFrameworks": [
      "react",
      "vue",
      "angular",
      "web-components",
      "ember",
      "html",
      "svelte",
      "preact",
      "react-native"
    ],
    "icon": "https://raw.githubusercontent.com/JohnAlbin/storybook-addon-fetch-mock/main/storybook-addon-fetch-mock.png"
  }
}
